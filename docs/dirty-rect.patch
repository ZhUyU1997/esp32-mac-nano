--- a/main/core/macplus/include/macplus.h
+++ b/main/core/macplus/include/macplus.h
@@ -1,6 +1,10 @@
 #ifndef MACPLUS_H
 #define MACPLUS_H
 
+/* Comment out to disable dirty-rectangle partial blit and fall back to
+ * full-frame blit (for A/B performance comparison). */
+#define ENABLE_DIRTY_RECT
+
 #include <stddef.h>
 #include <stdint.h>
 
@@ -76,7 +80,11 @@ typedef struct macplus {
 
 	uint8_t *vbuf1;
 	uint8_t *vbuf2;
+#ifdef ENABLE_DIRTY_RECT
+	int16_t dirty_x1, dirty_y1, dirty_x2, dirty_y2;
+#else
 	uint8_t vbuf_dirty;
+#endif
 	uint8_t *sbuf1;
 	uint8_t *sbuf2;
 	void (*frame_callback)(uint8_t *framebuffer, void *ctx);
@@ -97,10 +105,48 @@ typedef struct macplus {
 	uint8_t shm_region[512];
 } macplus_t;
 
-// atomic variants (zero-overhead on Xtensa, use if cross-core visibility issues suspected):
-#define VBUF_MARK_DIRTY(s)  __atomic_store_n(&(s)->vbuf_dirty, 1, __ATOMIC_RELAXED)
-#define VBUF_CLEAR_DIRTY(s) __atomic_store_n(&(s)->vbuf_dirty, 0, __ATOMIC_RELAXED)
-#define VBUF_IS_DIRTY(s)    __atomic_load_n(&(s)->vbuf_dirty, __ATOMIC_RELAXED)
+#ifdef ENABLE_DIRTY_RECT
+/* Dirty-rectangle tracking.
+ * dirty_x1 > dirty_x2 means “no dirty region” (initial state after clear).
+ * Producer (core 1, 68k emu) expands the rectangle on screen writes.
+ * Consumer (core 0, blit worker) reads & clears under VSYNC. */
+#define VBUF_INIT_DIRTY(s) do { \
+	(s)->dirty_x1 = 1; (s)->dirty_y1 = 0; \
+	(s)->dirty_x2 = 0; (s)->dirty_y2 = 0; \
+} while(0)
+
+#define VBUF_IS_DIRTY(s) ((s)->dirty_x1 < (s)->dirty_x2)
+
+#define VBUF_MARK_DIRTY_ALL(s) do { \
+	(s)->dirty_x1 = 0; (s)->dirty_y1 = 0; \
+	(s)->dirty_x2 = (int16_t)DISP_WIDTH; \
+	(s)->dirty_y2 = (int16_t)DISP_HEIGHT; \
+} while(0)
+
+#define VBUF_MARK_DIRTY_RECT(s, x1, y1, x2, y2) do { \
+	int16_t _rx1 = (int16_t)(x1), _ry1 = (int16_t)(y1); \
+	int16_t _rx2 = (int16_t)(x2), _ry2 = (int16_t)(y2); \
+	if (_rx1 < 0) _rx1 = 0; \
+	if (_ry1 < 0) _ry1 = 0; \
+	if (_rx2 > (int16_t)DISP_WIDTH)  _rx2 = (int16_t)DISP_WIDTH; \
+	if (_ry2 > (int16_t)DISP_HEIGHT) _ry2 = (int16_t)DISP_HEIGHT; \
+	if (VBUF_IS_DIRTY(s)) { \
+		if (_rx1 < (s)->dirty_x1) (s)->dirty_x1 = _rx1; \
+		if (_ry1 < (s)->dirty_y1) (s)->dirty_y1 = _ry1; \
+		if (_rx2 > (s)->dirty_x2) (s)->dirty_x2 = _rx2; \
+		if (_ry2 > (s)->dirty_y2) (s)->dirty_y2 = _ry2; \
+	} else { \
+		(s)->dirty_x1 = _rx1; (s)->dirty_y1 = _ry1; \
+		(s)->dirty_x2 = _rx2; (s)->dirty_y2 = _ry2; \
+	} \
+} while(0)
+
+#define VBUF_CLEAR_DIRTY(s) VBUF_INIT_DIRTY(s)
+#else
+#define VBUF_MARK_DIRTY(s)    __atomic_store_n(&(s)->vbuf_dirty, 1, __ATOMIC_RELAXED)
+#define VBUF_CLEAR_DIRTY(s)   __atomic_store_n(&(s)->vbuf_dirty, 0, __ATOMIC_RELAXED)
+#define VBUF_IS_DIRTY(s)      __atomic_load_n(&(s)->vbuf_dirty, __ATOMIC_RELAXED)
+#endif
 
 macplus_t *macplus_instance(void);
 
diff --git a/main/driver/video/frame_blit.h b/main/driver/video/frame_blit.h
index 1fcaf23..cf2105c 100644
--- a/main/driver/video/frame_blit.h
+++ b/main/driver/video/frame_blit.h
@@ -85,4 +85,46 @@ static inline void FAST_FUNC_ATTR blit_mac_mono_to_lcd_rgba(void *restrict lcd_f
 	}
 }
 
+/* Partial blit: only the LCD sub-rectangle [lcd_x1,lcd_x2) × [lcd_y1,lcd_y2).
+ * Coordinates are 4-pixel aligned by the function. */
+static inline void FAST_FUNC_ATTR blit_mac_mono_to_lcd_rgba_rect(
+	void *restrict lcd_fb, const uint8_t *restrict mac_fb,
+	int lcd_h, int lcd_w,
+	int lcd_x1, int lcd_y1, int lcd_x2, int lcd_y2)
+{
+	int ax1 = lcd_x1 & ~3;
+	int ax2 = (lcd_x2 + 3) & ~3;
+	int stride_u32 = lcd_w / 4;
+
+	if (ax2 > lcd_w) ax2 = lcd_w;
+	if (ax1 >= ax2) return;
+
+	for (int dst_y = lcd_y1; dst_y < lcd_y2; dst_y++) {
+		const int src_x = (lcd_h - 1 - dst_y);
+		const uint8_t bit_idx = (uint8_t)((7 - src_x) & 7);
+		const int src_byte_idx = src_x >> 3;
+
+		uint32_t *dst_u32 = (uint32_t *)lcd_fb + (size_t)dst_y * (size_t)stride_u32 + (size_t)(ax1 / 4);
+		const uint8_t *src_ptr = mac_fb + src_byte_idx + (size_t)(ax1 / 4) * 320u;
+
+		for (int dst_x = ax1; dst_x < ax2; dst_x += 4, src_ptr += 320) {
+			const uint32_t b0 = ((uint32_t)(src_ptr[0] >> bit_idx) & 1u);
+			const uint32_t b1 = ((uint32_t)(src_ptr[80] >> bit_idx) & 1u);
+			const uint32_t b2 = ((uint32_t)(src_ptr[160] >> bit_idx) & 1u);
+			const uint32_t b3 = ((uint32_t)(src_ptr[240] >> bit_idx) & 1u);
+
+			const uint32_t m0 = (uint32_t)0 - b0;
+			const uint32_t m1 = (uint32_t)0 - b1;
+			const uint32_t m2 = (uint32_t)0 - b2;
+			const uint32_t m3 = (uint32_t)0 - b3;
+
+			const uint32_t o0 = (~m0) & 0x000000FFu;
+			const uint32_t o1 = ((~m1) & 0x000000FFu) << 8;
+			const uint32_t o2 = ((~m2) & 0x000000FFu) << 16;
+			const uint32_t o3 = ((~m3) & 0x000000FFu) << 24;
+			*dst_u32++ = o0 | o1 | o2 | o3;
+		}
+	}
+}
+
 #endif
