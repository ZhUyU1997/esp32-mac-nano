diff --git a/main/arch/esp32/mach-s3/ui/ble_panel.c b/main/arch/esp32/mach-s3/ui/ble_panel.c
new file mode 100644
index 0000000..387ad8b
--- /dev/null
+++ b/main/arch/esp32/mach-s3/ui/ble_panel.c
@@ -0,0 +1,457 @@
+#include <stdint.h>
+#include <stdbool.h>
+#include <stdio.h>
+#include <string.h>
+
+#include "lvgl.h"
+#include "ble_panel.h"
+#include "ble/input-ble-hid.h"
+#include "settings_ui.h"
+
+extern const lv_font_t mono_opposans_18;
+
+/* ------------------------------------------------------------------ */
+/* Internal state                                                      */
+/* ------------------------------------------------------------------ */
+
+#define BLE_PANEL_MAX_ROWS 24
+#define BLE_PANEL_ROW_NAME_MAX 48
+
+typedef struct {
+	lv_obj_t *title_label;
+	lv_obj_t *status_label;
+	lv_obj_t *switch_obj;
+	lv_obj_t *content_panel;
+	lv_obj_t *placeholder_label;
+	lv_obj_t *device_list;
+	lv_obj_t *discovered_header;
+	lv_obj_t *rows[BLE_PANEL_MAX_ROWS];
+	char row_names[BLE_PANEL_MAX_ROWS][BLE_PANEL_ROW_NAME_MAX];
+	int row_count;
+	int selected_idx;
+	bool selected_is_paired;
+	lv_obj_t *scan_btn;
+	lv_obj_t *forget_btn;
+	lv_obj_t *scan_btn_label;
+	lv_timer_t *refresh_timer;
+	bool ble_on;
+} ble_panel_state_t;
+
+static ble_panel_state_t g_ble;
+
+/* Forward decl */
+static void on_device_row_clicked(lv_event_t *e);
+
+/* ------------------------------------------------------------------ */
+/* Helpers                                                             */
+/* ------------------------------------------------------------------ */
+
+static lv_obj_t *create_panel(lv_obj_t *parent, int32_t x, int32_t y, int32_t w, int32_t h)
+{
+	lv_obj_t *panel = lv_obj_create(parent);
+	lv_obj_set_pos(panel, x, y);
+	lv_obj_set_size(panel, w, h);
+	lv_obj_clear_flag(panel, LV_OBJ_FLAG_SCROLLABLE);
+	lv_obj_set_style_radius(panel, UI_PANEL_RADIUS, 0);
+	lv_obj_set_style_border_width(panel, 1, 0);
+	lv_obj_set_style_border_color(panel, lv_color_black(), 0);
+	lv_obj_set_style_bg_color(panel, lv_color_white(), 0);
+	lv_obj_set_style_bg_opa(panel, LV_OPA_COVER, 0);
+	lv_obj_set_style_pad_all(panel, 10, 0);
+	return panel;
+}
+
+/* ------------------------------------------------------------------ */
+/* Row creation                                                        */
+/* ------------------------------------------------------------------ */
+
+static const int32_t ROW_H = 28;
+
+static lv_obj_t *add_device_row(lv_obj_t *list, const char *text)
+{
+	lv_obj_t *row = lv_list_add_button(list, NULL, "");
+	lv_obj_clear_flag(row, LV_OBJ_FLAG_CHECKABLE);
+	lv_obj_set_width(row, lv_pct(100));
+	lv_obj_set_height(row, ROW_H);
+	lv_obj_clear_flag(row, LV_OBJ_FLAG_SCROLLABLE);
+	lv_obj_set_style_radius(row, 0, 0);
+	lv_obj_set_style_border_width(row, 0, LV_PART_MAIN);
+	lv_obj_set_style_bg_color(row, lv_color_white(), 0);
+	lv_obj_set_style_bg_opa(row, LV_OPA_COVER, 0);
+	lv_obj_set_style_pad_left(row, 4, 0);
+	lv_obj_set_style_pad_right(row, 4, 0);
+	lv_obj_set_style_pad_top(row, 1, 0);
+	lv_obj_set_style_pad_bottom(row, 1, 0);
+	lv_obj_set_style_shadow_width(row, 0, 0);
+
+	lv_obj_t *label = lv_obj_get_child(row, 0);
+	if (!label) label = lv_label_create(row);
+	lv_label_set_text(label, text);
+	lv_obj_set_style_text_color(label, lv_color_black(), 0);
+	lv_obj_set_style_text_font(label, &mono_opposans_18, 0);
+	lv_label_set_long_mode(label, LV_LABEL_LONG_DOT);
+	return row;
+}
+
+static void highlight_row(lv_obj_t *row, bool on)
+{
+	if (!row) return;
+	lv_obj_set_style_border_width(row, on ? 1 : 0, LV_PART_MAIN);
+	lv_obj_set_style_border_color(row, lv_color_black(), LV_PART_MAIN);
+	lv_obj_set_style_bg_color(row, on ? lv_color_black() : lv_color_white(), 0);
+	lv_obj_t *label = lv_obj_get_child(row, 0);
+	if (label) {
+		lv_obj_set_style_text_color(label, on ? lv_color_white() : lv_color_black(), 0);
+	}
+}
+
+/* ------------------------------------------------------------------ */
+/* UI refresh — rebuild device list from BLE APIs                      */
+/* ------------------------------------------------------------------ */
+
+static void ble_panel_refresh(void)
+{
+	if (!g_ble.ble_on || !g_ble.device_list)
+		return;
+
+	/* Save scroll position */
+	int32_t scroll_y = lv_obj_get_scroll_y(g_ble.device_list);
+
+	lv_obj_clean(g_ble.device_list);
+
+	int count = 0;
+	bool scanning = ble_hid_host_is_scanning();
+	int paired_count = ble_get_paired_count();
+	int disc_count = ble_get_discovered_count();
+	char buf[48];
+	uint8_t bda[6];
+
+	g_ble.selected_idx = -1;
+	g_ble.selected_is_paired = false;
+
+	/* ── Paired devices ──────────────────────────────────── */
+	for (int i = 0; i < paired_count && count < BLE_PANEL_MAX_ROWS; i++) {
+		bool connected = false;
+		if (!ble_get_paired_info(i, buf, sizeof(buf), bda, &connected))
+			continue;
+
+		char row_text[64];
+		snprintf(row_text, sizeof(row_text), "%s  %s",
+			connected ? "\u25CF" : "\u25CB", buf);
+
+		g_ble.rows[count] = add_device_row(g_ble.device_list, row_text);
+		(void)snprintf(g_ble.row_names[count], sizeof(g_ble.row_names[0]), "%s", buf);
+		lv_obj_add_event_cb(g_ble.rows[count], on_device_row_clicked,
+			LV_EVENT_CLICKED, (void *)(uintptr_t)(count | 0x80000000)); /* paired flag */
+		count++;
+	}
+
+	/* ── Discovered header ────────────────────────────────── */
+	if (disc_count > 0 && count > 0) {
+		g_ble.discovered_header = lv_label_create(g_ble.device_list);
+		lv_label_set_text(g_ble.discovered_header, "Discovered");
+		lv_obj_set_style_text_color(g_ble.discovered_header, lv_color_black(), 0);
+		lv_obj_set_style_text_font(g_ble.discovered_header, &mono_opposans_18, 0);
+		lv_obj_set_style_pad_left(g_ble.discovered_header, 4, 0);
+	} else {
+		g_ble.discovered_header = NULL;
+	}
+
+	/* ── Discovered devices ────────────────────────────────── */
+	for (int i = 0; i < disc_count && count < BLE_PANEL_MAX_ROWS; i++) {
+		uint8_t addr_type = 0;
+		if (!ble_get_discovered_info(i, buf, sizeof(buf), bda, &addr_type))
+			continue;
+
+		char row_text[64];
+		snprintf(row_text, sizeof(row_text), "\u2726 %s  [Pair]", buf);
+
+		g_ble.rows[count] = add_device_row(g_ble.device_list, row_text);
+		(void)snprintf(g_ble.row_names[count], sizeof(g_ble.row_names[0]), "%s", buf);
+		lv_obj_add_event_cb(g_ble.rows[count], on_device_row_clicked,
+			LV_EVENT_CLICKED, (void *)(uintptr_t)(count)); /* not paired */
+		count++;
+	}
+
+	g_ble.row_count = count;
+
+	/* Restore scroll */
+	lv_obj_scroll_to_y(g_ble.device_list, scroll_y, LV_ANIM_OFF);
+
+	/* ── Status label ─────────────────────────────────────── */
+	if (scanning) {
+		snprintf(buf, sizeof(buf), "Scanning\u2026");
+	} else if (paired_count > 0) {
+		int conn = ble_hid_host_connected_count();
+		snprintf(buf, sizeof(buf), "%d connected", conn);
+	} else {
+		snprintf(buf, sizeof(buf), "Ready");
+	}
+	if (g_ble.status_label)
+		lv_label_set_text(g_ble.status_label, buf);
+
+	/* ── Scan button text ─────────────────────────────────── */
+	if (g_ble.scan_btn_label)
+		lv_label_set_text(g_ble.scan_btn_label, scanning ? "Stop" : "Scan");
+}
+
+static void ble_panel_refresh_timer_cb(lv_timer_t *t)
+{
+	(void)t;
+	if (g_ble.ble_on)
+		ble_panel_refresh();
+}
+
+/* ------------------------------------------------------------------ */
+/* Device row click handler                                            */
+/* ------------------------------------------------------------------ */
+
+static void on_device_row_clicked(lv_event_t *e)
+{
+	uintptr_t data = (uintptr_t)lv_event_get_user_data(e);
+	int idx = (int)(data & 0x7FFFFFFF);
+	bool is_paired = (data & 0x80000000) != 0;
+
+	/* Deselect previous */
+	if (g_ble.selected_idx >= 0 && g_ble.selected_idx < g_ble.row_count) {
+		highlight_row(g_ble.rows[g_ble.selected_idx], false);
+	}
+
+	if (is_paired) {
+		/* Select paired device */
+		g_ble.selected_idx = idx;
+		g_ble.selected_is_paired = true;
+		highlight_row(g_ble.rows[idx], true);
+	} else {
+		/* Discovered device — initiate pairing */
+		uint8_t bda[6];
+		uint8_t addr_type = 0;
+		char name[32];
+		if (ble_get_discovered_info(idx, name, sizeof(name), bda, &addr_type)) {
+			ble_connect_to_device(bda, addr_type);
+		}
+		g_ble.selected_idx = -1;
+		g_ble.selected_is_paired = false;
+	}
+}
+
+/* ------------------------------------------------------------------ */
+/* Rebuild content panel based on BLE state                            */
+/* ------------------------------------------------------------------ */
+
+static void ble_panel_rebuild_content(void)
+{
+	if (!g_ble.content_panel)
+		return;
+
+	/* Delete dynamic content (1st child), keep button row */
+	if (g_ble.placeholder_label) {
+		lv_obj_delete(g_ble.placeholder_label);
+		g_ble.placeholder_label = NULL;
+	}
+	if (g_ble.device_list) {
+		lv_obj_delete(g_ble.device_list);
+		g_ble.device_list = NULL;
+	}
+	g_ble.selected_idx = -1;
+	g_ble.selected_is_paired = false;
+
+	if (g_ble.ble_on) {
+		g_ble.device_list = lv_list_create(g_ble.content_panel);
+		lv_obj_set_size(g_ble.device_list, lv_pct(100), LV_SIZE_CONTENT);
+		lv_obj_set_flex_grow(g_ble.device_list, 1);
+		lv_obj_set_style_border_width(g_ble.device_list, 0, 0);
+		lv_obj_set_style_bg_opa(g_ble.device_list, LV_OPA_TRANSP, 0);
+		lv_obj_set_style_pad_all(g_ble.device_list, 0, 0);
+		lv_obj_set_style_pad_row(g_ble.device_list, 2, 0);
+		lv_obj_set_scroll_dir(g_ble.device_list, LV_DIR_VER);
+		lv_obj_set_scrollbar_mode(g_ble.device_list, LV_SCROLLBAR_MODE_AUTO);
+		/* move above btn_row */
+		lv_obj_move_to_index(g_ble.device_list, 0);
+	} else {
+		g_ble.placeholder_label = lv_label_create(g_ble.content_panel);
+		lv_label_set_text(g_ble.placeholder_label, "Bluetooth is off");
+		lv_obj_set_style_text_color(g_ble.placeholder_label, lv_color_black(), 0);
+		lv_obj_set_style_text_font(g_ble.placeholder_label, &mono_opposans_18, 0);
+		lv_obj_set_flex_grow(g_ble.placeholder_label, 1);
+		lv_obj_set_style_text_align(g_ble.placeholder_label, LV_TEXT_ALIGN_CENTER, 0);
+		lv_obj_move_to_index(g_ble.placeholder_label, 0);
+	}
+
+	ble_panel_refresh();
+}
+
+/* ------------------------------------------------------------------ */
+/* Switch callback                                                     */
+/* ------------------------------------------------------------------ */
+
+static void on_switch_changed(lv_event_t *e)
+{
+	lv_obj_t *sw = lv_event_get_target_obj(e);
+	g_ble.ble_on = lv_obj_has_state(sw, LV_STATE_CHECKED);
+
+	if (g_ble.ble_on) {
+		ble_hid_host_init();
+	} else {
+		ble_hid_host_deinit();
+	}
+
+	ble_panel_rebuild_content();
+}
+
+/* ------------------------------------------------------------------ */
+/* Scan button callback                                                */
+/* ------------------------------------------------------------------ */
+
+static void on_scan_clicked(lv_event_t *e)
+{
+	(void)e;
+	if (!g_ble.ble_on)
+		return;
+
+	if (ble_hid_host_is_scanning()) {
+		ble_hid_host_stop_scan();
+	} else {
+		ble_hid_host_start_scan();
+	}
+	ble_panel_refresh();
+}
+
+/* ------------------------------------------------------------------ */
+/* Forget button callback                                              */
+/* ------------------------------------------------------------------ */
+
+static void on_forget_clicked(lv_event_t *e)
+{
+	(void)e;
+	if (!g_ble.ble_on)
+		return;
+	if (g_ble.selected_idx < 0 || !g_ble.selected_is_paired)
+		return;
+
+	const char *name = g_ble.row_names[g_ble.selected_idx];
+
+	/* Find BDA from paired list */
+	uint8_t bda[6] = {0};
+	char buf[48];
+	for (int i = 0; i < ble_get_paired_count(); i++) {
+		bool conn;
+		if (ble_get_paired_info(i, buf, sizeof(buf), bda, &conn)) {
+			if (strcmp(buf, name) == 0)
+				break;
+		}
+	}
+
+	ble_forget_device(bda);
+	g_ble.selected_idx = -1;
+	g_ble.selected_is_paired = false;
+	ble_panel_refresh();
+}
+
+static void on_clear_clicked(lv_event_t *e)
+{
+	(void)e;
+	ble_clear_all_bonds();
+	g_ble.selected_idx = -1;
+	g_ble.selected_is_paired = false;
+	ble_panel_refresh();
+}
+
+/* ------------------------------------------------------------------ */
+/* Public API                                                          */
+/* ------------------------------------------------------------------ */
+
+void ble_panel_create(lv_obj_t *screen, int32_t x, int32_t y, int32_t w, int32_t h)
+{
+	memset(&g_ble, 0, sizeof(g_ble));
+	g_ble.selected_idx = -1;
+
+	const int32_t title_h = 22;
+	const int32_t btn_w = 76;
+	const int32_t btn_h = 30;
+	const int32_t btn_gap = 8;
+	const int32_t panel_h = h - title_h;
+
+	/* ── Title row ──────────────────────────────────────── */
+	g_ble.title_label = lv_label_create(screen);
+	lv_label_set_text(g_ble.title_label, "Bluetooth");
+	lv_obj_set_style_text_color(g_ble.title_label, lv_color_black(), 0);
+	lv_obj_set_style_text_font(g_ble.title_label, &mono_opposans_18, 0);
+	lv_obj_set_pos(g_ble.title_label, x + 2, y);
+
+	/* Status — right side of title, left of switch */
+	g_ble.status_label = lv_label_create(screen);
+	lv_label_set_text(g_ble.status_label, "Off");
+	lv_obj_set_style_text_color(g_ble.status_label, lv_color_black(), 0);
+	lv_obj_set_style_text_font(g_ble.status_label, &mono_opposans_18, 0);
+	lv_obj_set_style_text_align(g_ble.status_label, LV_TEXT_ALIGN_RIGHT, 0);
+
+	/* Switch — rightmost */
+	const int32_t sw_w = 44;
+	const int32_t sw_h = 22;
+	g_ble.switch_obj = lv_switch_create(screen);
+	lv_obj_set_size(g_ble.switch_obj, sw_w, sw_h);
+	lv_obj_set_pos(g_ble.switch_obj, x + w - sw_w, y);
+	lv_obj_set_style_bg_color(g_ble.switch_obj, lv_color_white(), LV_PART_MAIN);
+	lv_obj_set_style_bg_opa(g_ble.switch_obj, LV_OPA_COVER, LV_PART_MAIN);
+	lv_obj_set_style_border_width(g_ble.switch_obj, 1, LV_PART_MAIN);
+	lv_obj_set_style_border_color(g_ble.switch_obj, lv_color_black(), LV_PART_MAIN);
+	lv_obj_set_style_bg_color(g_ble.switch_obj, lv_color_black(), LV_PART_INDICATOR);
+	lv_obj_set_style_bg_opa(g_ble.switch_obj, LV_OPA_COVER, LV_PART_INDICATOR);
+	lv_obj_set_style_bg_color(g_ble.switch_obj, lv_color_white(), LV_PART_KNOB);
+	lv_obj_set_style_bg_opa(g_ble.switch_obj, LV_OPA_COVER, LV_PART_KNOB);
+	lv_obj_set_style_border_width(g_ble.switch_obj, 1, LV_PART_KNOB);
+	lv_obj_set_style_border_color(g_ble.switch_obj, lv_color_black(), LV_PART_KNOB);
+	lv_obj_add_event_cb(g_ble.switch_obj, on_switch_changed, LV_EVENT_VALUE_CHANGED, NULL);
+
+	/* Position status label between title and switch */
+	{
+		int32_t sw_x = x + w - sw_w;
+		lv_obj_set_width(g_ble.status_label, sw_x - x - 80 - 6);
+		lv_obj_set_pos(g_ble.status_label, x + 80, y);
+	}
+
+	/* ── Content panel ──────────────────────────────────── */
+	const int32_t panel_top = y + title_h;
+	g_ble.content_panel = create_panel(screen, x, panel_top, w, panel_h);
+	lv_obj_set_layout(g_ble.content_panel, LV_LAYOUT_FLEX);
+	lv_obj_set_flex_flow(g_ble.content_panel, LV_FLEX_FLOW_COLUMN);
+
+	/* Default: BLE is off → show placeholder */
+	g_ble.placeholder_label = lv_label_create(g_ble.content_panel);
+	lv_label_set_text(g_ble.placeholder_label, "Bluetooth is off");
+	lv_obj_set_style_text_color(g_ble.placeholder_label, lv_color_black(), 0);
+	lv_obj_set_style_text_font(g_ble.placeholder_label, &mono_opposans_18, 0);
+	lv_obj_set_flex_grow(g_ble.placeholder_label, 1);
+	lv_obj_set_style_text_align(g_ble.placeholder_label, LV_TEXT_ALIGN_CENTER, 0);
+
+	/* ── Bottom buttons (inside panel) ──────────────────── */
+	lv_obj_t *btn_row = lv_obj_create(g_ble.content_panel);
+	lv_obj_set_size(btn_row, lv_pct(100), LV_SIZE_CONTENT);
+	lv_obj_set_flex_grow(btn_row, 0);
+	lv_obj_clear_flag(btn_row, LV_OBJ_FLAG_SCROLLABLE);
+	lv_obj_set_style_border_width(btn_row, 0, 0);
+	lv_obj_set_style_bg_opa(btn_row, LV_OPA_TRANSP, 0);
+	lv_obj_set_style_pad_all(btn_row, 0, 0);
+	lv_obj_set_layout(btn_row, LV_LAYOUT_FLEX);
+	lv_obj_set_flex_flow(btn_row, LV_FLEX_FLOW_ROW);
+	lv_obj_set_flex_align(btn_row, LV_FLEX_ALIGN_CENTER, LV_FLEX_ALIGN_CENTER, LV_FLEX_ALIGN_CENTER);
+	lv_obj_set_style_pad_column(btn_row, btn_gap, 0);
+	lv_obj_set_style_pad_top(btn_row, 6, 0);
+
+	g_ble.scan_btn = create_action_btn(btn_row, "Scan");
+	lv_obj_set_size(g_ble.scan_btn, btn_w, btn_h);
+	g_ble.scan_btn_label = lv_obj_get_child(g_ble.scan_btn, 0);
+	lv_obj_add_event_cb(g_ble.scan_btn, on_scan_clicked, LV_EVENT_CLICKED, NULL);
+
+	g_ble.forget_btn = create_action_btn(btn_row, "Forget");
+	lv_obj_set_size(g_ble.forget_btn, btn_w, btn_h);
+	lv_obj_add_event_cb(g_ble.forget_btn, on_forget_clicked, LV_EVENT_CLICKED, NULL);
+
+	lv_obj_t *clear_btn = create_action_btn(btn_row, "Clear");
+	lv_obj_set_size(clear_btn, btn_w, btn_h);
+	lv_obj_add_event_cb(clear_btn, on_clear_clicked, LV_EVENT_CLICKED, NULL);
+
+	/* ── Periodic refresh timer ─────────────────────────── */
+	g_ble.refresh_timer = lv_timer_create(ble_panel_refresh_timer_cb, 500, NULL);
+}
