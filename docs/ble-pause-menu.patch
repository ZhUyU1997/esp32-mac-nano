diff --git a/main/arch/esp32/mach-s3/driver/ble/ble_dev_cache.c b/main/arch/esp32/mach-s3/driver/ble/ble_dev_cache.c
new file mode 100644
index 0000000..7fa87c2
--- /dev/null
+++ b/main/arch/esp32/mach-s3/driver/ble/ble_dev_cache.c
@@ -0,0 +1,222 @@
+#include <stdio.h>
+#include <string.h>
+#include <stdlib.h>
+#include "esp_log.h"
+#include "esp_gap_ble_api.h"
+#include "esp_gattc_api.h"
+#include "ble_priv.h"
+#include "ble_dev_cache.h"
+
+static const char *TAG = "ble_cache";
+
+/* ------------------------------------------------------------------ */
+/* Name & discovered devices cache                                    */
+/* ------------------------------------------------------------------ */
+
+#define MAX_DISCOVERED 16
+
+typedef struct {
+	uint8_t bda[6];
+	char name[48];
+	uint8_t addr_type;
+} ble_scan_entry_t;
+
+static ble_scan_entry_t s_discovered[MAX_DISCOVERED];
+static int s_discovered_count = 0;
+
+/* ------------------------------------------------------------------ */
+/* Cache management                                                   */
+/* ------------------------------------------------------------------ */
+
+void ble_dev_name_cache_set(const uint8_t *bda, const char *name)
+{
+	for (int i = 0; i < s_discovered_count; i++) {
+		if (memcmp(s_discovered[i].bda, bda, 6) == 0) {
+			snprintf(s_discovered[i].name, sizeof(s_discovered[i].name),
+				"%.*s", (int)(sizeof(s_discovered[i].name) - 1), name);
+			return;
+		}
+	}
+}
+
+static const char *name_cache_get(const uint8_t *bda)
+{
+	for (int i = 0; i < s_discovered_count; i++) {
+		if (memcmp(s_discovered[i].bda, bda, 6) == 0)
+			return s_discovered[i].name;
+	}
+	return NULL;
+}
+
+void ble_dev_discovered_add(const uint8_t *bda, uint8_t addr_type, const char *name)
+{
+	/* Don't add if already in discovered list */
+	for (int i = 0; i < s_discovered_count; i++) {
+		if (memcmp(s_discovered[i].bda, bda, 6) == 0) {
+			if (name && name[0]) {
+				snprintf(s_discovered[i].name, sizeof(s_discovered[i].name),
+					"%.*s", (int)(sizeof(s_discovered[i].name) - 1), name);
+			}
+			return;
+		}
+	}
+	/* Don't add if already paired */
+	if (is_bonded_addr(bda))
+		return;
+	/* Don't add if already connected */
+	for (int i = 0; i < MAX_BLE_DEVICES; i++) {
+		if (s_devs[i].in_use && memcmp(s_devs[i].bda, bda, 6) == 0)
+			return;
+	}
+
+	if (s_discovered_count >= MAX_DISCOVERED)
+		return;
+	memcpy(s_discovered[s_discovered_count].bda, bda, 6);
+	s_discovered[s_discovered_count].addr_type = addr_type;
+	if (name && name[0]) {
+		snprintf(s_discovered[s_discovered_count].name,
+			sizeof(s_discovered[0].name), "%.*s",
+			(int)(sizeof(s_discovered[0].name) - 1), name);
+	} else {
+		s_discovered[s_discovered_count].name[0] = '\0';
+	}
+	s_discovered_count++;
+}
+
+void ble_dev_discovered_clear(void)
+{
+	s_discovered_count = 0;
+}
+
+/* ------------------------------------------------------------------ */
+/* Paired (bonded) device queries                                      */
+/* ------------------------------------------------------------------ */
+
+int ble_get_paired_count(void)
+{
+	return esp_ble_get_bond_device_num();
+}
+
+bool ble_get_paired_info(int idx, char *name_out, size_t name_len,
+                         uint8_t *bda_out, bool *connected_out)
+{
+	int count = esp_ble_get_bond_device_num();
+	if (idx < 0 || idx >= count)
+		return false;
+
+	esp_ble_bond_dev_t *bonds = malloc(count * sizeof(esp_ble_bond_dev_t));
+	if (!bonds)
+		return false;
+	esp_ble_get_bond_device_list(&count, bonds);
+	memcpy(bda_out, bonds[idx].bd_addr, 6);
+	free(bonds);
+
+	/* Look up cached name */
+	const char *cached = name_cache_get(bda_out);
+	if (cached && cached[0])
+		snprintf(name_out, name_len, "%s", cached);
+	else
+		snprintf(name_out, name_len, "%s", addr_str(bda_out));
+
+	/* Check if connected */
+	bool conn = false;
+	for (int i = 0; i < MAX_BLE_DEVICES; i++) {
+		if (s_devs[i].in_use && memcmp(s_devs[i].bda, bda_out, 6) == 0) {
+			conn = true;
+			break;
+		}
+	}
+	if (connected_out)
+		*connected_out = conn;
+
+	return true;
+}
+
+bool ble_is_device_connected(const uint8_t *bda)
+{
+	for (int i = 0; i < MAX_BLE_DEVICES; i++) {
+		if (s_devs[i].in_use && memcmp(s_devs[i].bda, bda, 6) == 0)
+			return true;
+	}
+	return false;
+}
+
+void ble_forget_device(const uint8_t *bda)
+{
+	/* Disconnect if connected */
+	for (int i = 0; i < MAX_BLE_DEVICES; i++) {
+		if (s_devs[i].in_use && memcmp(s_devs[i].bda, bda, 6) == 0) {
+			esp_ble_gattc_close(s_gattc_if, s_devs[i].conn_id);
+			memset(&s_devs[i], 0, sizeof(s_devs[i]));
+			break;
+		}
+	}
+	/* Remove bond */
+	esp_ble_remove_bond_device(bda);
+
+	/* Remove from discovered list */
+	for (int i = 0; i < s_discovered_count; i++) {
+		if (memcmp(s_discovered[i].bda, bda, 6) == 0) {
+			s_discovered[i] = s_discovered[s_discovered_count - 1];
+			s_discovered_count--;
+			break;
+		}
+	}
+}
+
+/* ------------------------------------------------------------------ */
+/* Discovered device queries                                           */
+/* ------------------------------------------------------------------ */
+
+int ble_get_discovered_count(void)
+{
+	return s_discovered_count;
+}
+
+bool ble_get_discovered_info(int idx, char *name_out, size_t name_len,
+                             uint8_t *bda_out, uint8_t *addr_type_out)
+{
+	if (idx < 0 || idx >= s_discovered_count)
+		return false;
+
+	memcpy(bda_out, s_discovered[idx].bda, 6);
+	if (addr_type_out)
+		*addr_type_out = s_discovered[idx].addr_type;
+
+	if (s_discovered[idx].name[0])
+		snprintf(name_out, name_len, "%s", s_discovered[idx].name);
+	else
+		snprintf(name_out, name_len, "%s", addr_str(s_discovered[idx].bda));
+	return true;
+}
+
+void ble_connect_to_device(const uint8_t *bda, uint8_t addr_type)
+{
+	connect_to(bda, addr_type);
+}
+
+void ble_clear_all_bonds(void)
+{
+	/* Disconnect all */
+	for (int i = 0; i < MAX_BLE_DEVICES; i++) {
+		if (s_devs[i].in_use && s_devs[i].conn_id != 0) {
+			esp_ble_gattc_close(s_gattc_if, s_devs[i].conn_id);
+		}
+		memset(&s_devs[i], 0, sizeof(s_devs[i]));
+	}
+
+	/* Remove all bonds */
+	int count = esp_ble_get_bond_device_num();
+	if (count > 0) {
+		esp_ble_bond_dev_t *bonds = malloc(count * sizeof(esp_ble_bond_dev_t));
+		if (bonds) {
+			esp_ble_get_bond_device_list(&count, bonds);
+			for (int i = 0; i < count; i++)
+				esp_ble_remove_bond_device(bonds[i].bd_addr);
+			free(bonds);
+		}
+	}
+
+	/* Clear discovered cache */
+	ble_dev_discovered_clear();
+}
diff --git a/main/arch/esp32/mach-s3/driver/ble/ble_dev_cache.h b/main/arch/esp32/mach-s3/driver/ble/ble_dev_cache.h
