diff --git a/main/arch/esp32/mach-s3/driver/ble/input-ble-hid.c b/main/arch/esp32/mach-s3/driver/ble/input-ble-hid.c
index 29aedc7..e19a361 100644
--- a/main/arch/esp32/mach-s3/driver/ble/input-ble-hid.c
+++ b/main/arch/esp32/mach-s3/driver/ble/input-ble-hid.c
@@ -18,6 +18,7 @@
 #include "esp_gatt_common_api.h"
 #include "input.h"
 #include "ble_priv.h"
+#include "ble_dev_cache.h"
 
 static const char *TAG = "ble_hid";
 
@@ -50,6 +51,8 @@ const char *addr_str(const uint8_t *bda)
 ble_dev_t s_devs[MAX_BLE_DEVICES];
 esp_gatt_if_t s_gattc_if = ESP_GATT_IF_NONE;
 bool s_restart_scan = false;
+static bool s_ready = false;
+static bool s_scanning = false;
 
 /* ------------------------------------------------------------------ */
 /* Slot management                                                    */
@@ -152,10 +155,12 @@ void esp_gap_cb(esp_gap_ble_cb_event_t event, esp_ble_gap_cb_param_t *param)
 	}
 	case ESP_GAP_BLE_SCAN_START_COMPLETE_EVT: {
 		ESP_LOGI(TAG, "scan started, status %d", param->scan_start_cmpl.status);
+		s_scanning = true;
 		break;
 	}
 	case ESP_GAP_BLE_SCAN_STOP_COMPLETE_EVT: {
 		ESP_LOGI(TAG, "scan stopped");
+		s_scanning = false;
 		if (s_restart_scan) {
 			s_restart_scan = false;
 			esp_ble_gap_start_scanning(0);
@@ -182,6 +187,33 @@ void esp_gap_cb(esp_gap_ble_cb_event_t event, esp_ble_gap_cb_param_t *param)
 			name[copy_len] = '\0';
 			ESP_LOGI(TAG, "SCAN: %s type=%d NAME: %s",
 				addr_str(p->scan_rst.bda), p->scan_rst.ble_addr_type, name);
+
+			/* Cache name and add to discovered list — HID devices only */
+			ble_dev_name_cache_set(p->scan_rst.bda, name);
+
+			/* Check for HID service UUID (0x1812) in advertising */
+			bool is_hid = false;
+			uint8_t svc_len = 0;
+			uint8_t *svc = esp_ble_resolve_adv_data_by_type(
+				p->scan_rst.ble_adv,
+				p->scan_rst.adv_data_len + p->scan_rst.scan_rsp_len,
+				ESP_BLE_AD_TYPE_16SRV_CMPL, &svc_len);
+			if (!svc) {
+				svc = esp_ble_resolve_adv_data_by_type(
+					p->scan_rst.ble_adv,
+					p->scan_rst.adv_data_len + p->scan_rst.scan_rsp_len,
+					ESP_BLE_AD_TYPE_16SRV_PART, &svc_len);
+			}
+			for (int j = 0; svc && j + 1 < svc_len; j += 2) {
+				if (svc[j] == 0x12 && svc[j + 1] == 0x18) {
+					is_hid = true;
+					break;
+				}
+			}
+
+			if (is_hid)
+				ble_dev_discovered_add(p->scan_rst.bda, p->scan_rst.ble_addr_type, name);
+
 			for (int i = 0; TARGET_DEVICE_NAMES[i] != NULL; i++) {
 				if (strcmp(name, TARGET_DEVICE_NAMES[i]) == 0) {
 					matched = true;
@@ -319,5 +351,76 @@ void ble_hid_host_init(void)
 	}
 	esp_ble_gatt_set_local_mtu(200);
 
+	s_ready = true;
 	ESP_LOGI(TAG, "BLE init done, scanning…");
 }
+
+/* ------------------------------------------------------------------ */
+/* Deinit                                                             */
+/* ------------------------------------------------------------------ */
+void ble_hid_host_deinit(void)
+{
+	if (!s_ready)
+		return;
+
+	ESP_LOGI(TAG, "BLE HID Host deinit");
+
+	/* Disconnect all devices */
+	for (int i = 0; i < MAX_BLE_DEVICES; i++) {
+		if (s_devs[i].in_use && s_devs[i].conn_id != 0) {
+			esp_ble_gattc_close(s_gattc_if, s_devs[i].conn_id);
+		}
+		memset(&s_devs[i], 0, sizeof(s_devs[i]));
+	}
+
+	s_scanning = false;
+	s_restart_scan = false;
+	s_ready = false;
+
+	esp_bluedroid_disable();
+	esp_bluedroid_deinit();
+	esp_bt_controller_disable();
+	esp_bt_controller_deinit();
+
+	ESP_LOGI(TAG, "BLE deinit complete");
+}
+
+/* ------------------------------------------------------------------ */
+/* State queries                                                       */
+/* ------------------------------------------------------------------ */
+bool ble_hid_host_is_ready(void)
+{
+	return s_ready;
+}
+
+int ble_hid_host_connected_count(void)
+{
+	int count = 0;
+	for (int i = 0; i < MAX_BLE_DEVICES; i++) {
+		if (s_devs[i].in_use)
+			count++;
+	}
+	return count;
+}
+
+void ble_hid_host_start_scan(void)
+{
+	if (!s_ready)
+		return;
+	ble_dev_discovered_clear();
+	s_scanning = true;
+	esp_ble_gap_start_scanning(0);
+}
+
+void ble_hid_host_stop_scan(void)
+{
+	if (!s_ready)
+		return;
+	s_scanning = false;
+	esp_ble_gap_stop_scanning();
+}
+
+bool ble_hid_host_is_scanning(void)
+{
+	return s_scanning;
+}
