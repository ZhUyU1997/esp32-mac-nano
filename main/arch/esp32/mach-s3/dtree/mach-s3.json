{
  "gpio-s3": { "name": "gpio", "base": 0 },
  "key-gpio-polled": {
    "name": "keys",
    "poll-interval-ms": 20,
    "keys": [
      { "gpio": 7, "active-low": true, "key-code": 259 },
      { "gpio": 15, "active-low": true, "key-code": 267 },
      { "gpio": 16, "active-low": true, "key-code": 260 }
    ]
  },
  "snd-i2s": {
    "name": "snd",
    "bclk_gpio": 5,
    "ws_gpio": 6,
    "dout_gpio": 4,
    "din_gpio": -1,
    "mclk_inv": false,
    "bclk_inv": false,
    "ws_inv": false,
    "ringbuf_bytes": 4096
  },
  "fb-st7701": {
    "name": "lcd",
    "brightness": 50,

    "spi_cs_gpio": 38,
    "spi_scl_gpio": 47,
    "spi_sda_gpio": 48,

    "rgb_de_gpio": -1,
    "rgb_pclk_gpio": 11,
    "rgb_vsync_gpio": 10,
    "rgb_hsync_gpio": 42,
    "rgb_disp_gpio": 9,

    "rgb_data0_gpio": 41,
