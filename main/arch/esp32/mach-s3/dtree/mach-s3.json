    "fb_bits_per_pixel": 8,
    "panel_bits_per_pixel": 16,

    "pclk_hz": 23000000,
    "bounce_lines": 16,

    "hsync_pulse_width": 2,
    "hsync_back_porch": 51,
    "hsync_front_porch": 32,
    "vsync_pulse_width": 2,
