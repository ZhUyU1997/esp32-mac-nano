{
  "name": "idf-mcp",
  "version": "0.1.0",
  "description": "ESP-IDF project console driven by an MCP agent, watched by a human",
  "type": "module",
  "bin": {
    "idf-mcp": "dist/idf-mcp.js"
  },
  "scripts": {
    "start": "tsx idf-mcp.ts",
    "start:mock": "MCP_IDF_MOCK=1 tsx idf-mcp.ts",
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "node client-test.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "express": "^4.22.2",
    "node-pty": "^1.1.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/express": "^4.17.23",
    "@types/node": "^22.0.0",
    "tsx": "^4.20.0",
    "typescript": "^7.0.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": ["node-pty"]
  }
}
